# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.
POSTGRES_USER=ideator
POSTGRES_PASSWORD=ideator
POSTGRES_DB=ideator

# Microsoft Foundry (key entregada por la universidad). La key nunca va en el código ni en commits.
# Endpoint del recurso con la ruta v1, ej: https://<recurso>.openai.azure.com/openai/v1
LLM_BASE_URL=https://tics420-lonzanizas-resource.openai.azure.com/openai/v1
LLM_API_KEY=
# Nombre del deployment en Foundry (el del grupo es gpt-6.1-sol)
LLM_MODEL=gpt-6.1-sol
# Tiempo máximo de espera por respuesta, en milisegundos (por defecto 300000 = 5 minutos)
LLM_TIMEOUT_MS=300000

# Secreto para firmar sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=

# SSO con Google (se obtiene en Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
