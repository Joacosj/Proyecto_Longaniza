# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.
POSTGRES_USER=ideator
POSTGRES_PASSWORD=ideator
POSTGRES_DB=ideator

# ---------------------------------------------------------------- IA: Google Cloud Vertex AI
# Proyecto de Google Cloud con la API de Vertex AI habilitada (usa los créditos del proyecto).
GCP_PROJECT_ID=
# "global" o una región como us-central1
GCP_LOCATION=global
# Clave JSON de la cuenta de servicio (rol "Vertex AI User"). Guárdala en secrets/gcp-key.json:
# esa carpeta nunca se sube. Esta ruta es la de los comandos deno (desde backend/); Docker usa
# su propia ruta y monta la carpeta secrets/ automáticamente.
GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-key.json
LLM_MODEL=google/gemini-3.5-flash
# Tiempo máximo de espera por respuesta, en milisegundos (10 minutos)
LLM_TIMEOUT_MS=600000
# Opcional: low, medium o high. Menos razonamiento = respuestas más rápidas y baratas.
LLM_REASONING_EFFORT=

# Otros proveedores (solo si no usas Vertex; deja GCP_PROJECT_ID vacío):
# - Cualquier API compatible con OpenAI con "Authorization: Bearer":
#   LLM_PROVIDER=openai, LLM_BASE_URL=..., LLM_API_KEY=..., LLM_MODEL=...
# - Microsoft Foundry: LLM_PROVIDER=foundry, LLM_BASE_URL=https://<recurso>.openai.azure.com/openai/v1
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=

# Secreto para firmar sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=

# URL pública del frontend. El SSO vuelve aquí. En Google Cloud Console registra como
# "URI de redireccionamiento autorizado": <APP_URL>/api/auth/sso/google/callback
APP_URL=http://localhost:5173

# SSO con Google (se obtiene en Google Cloud Console > Credenciales > ID de cliente OAuth,
# tipo "Aplicación web"). Si alguna queda vacía, el botón de Google no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
