{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "migrate": "deno run --allow-net --allow-env --allow-read src/db/migrate.ts",
    "test": "deno test --allow-net --allow-env --allow-read",
    "check": "deno check src/main.ts src/db/migrate.ts src/engine/fake.ts src/engine/ejemplo.ts src/engine/architectures.ts src/engine/llm_ping.ts src/engine/consistency.ts src/engine/documents.ts scripts/generar_ejemplo.ts scripts/conversar_definicion.ts src/engine/engine.ts scripts/generar_etapas.ts && deno lint && deno fmt --check",
    "llm:ping": "deno run --allow-net --allow-env --allow-read --env-file=../.env src/engine/llm_ping.ts",
    "docs:ejemplo": "deno run --allow-read --allow-write=../docs/ejemplo-salida scripts/generar_ejemplo.ts",
    "conversar": "deno run --allow-net --allow-env --allow-read --allow-write=definicion-borrador.json,definicion-sesion.json --env-file=../.env scripts/conversar_definicion.ts",
    "generar": "deno run --allow-net --allow-env --allow-read --allow-write=salida --env-file=../.env scripts/generar_etapas.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.6.0",
    "hono/": "npm:/hono@^4.6.0/",
    "bcryptjs": "npm:bcryptjs@^3.0.2",
    "postgres": "npm:postgres@^3.4.5"
  },
  "fmt": {
    "lineWidth": 100
  }
}
